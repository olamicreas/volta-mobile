{
  "manifest_version": 3,
  "name": "Local Form Draft Saver",
  "version": "1.0",
  "description": "Aggressive capture mode. Penetrates iframes.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "View Saved Drafts"
  }
}
